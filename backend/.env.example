# FoodSense backend local environment configuration.
#
# Copy this file to:
#   backend/.env
#
# IMPORTANT:
# Do not commit backend/.env or backend/secrets/ to Git.

FOODSENSE_ENV=development
FOODSENSE_DEBUG=true
FOODSENSE_API_VERSION=0.1.0

FOODSENSE_HOST=127.0.0.1
FOODSENSE_PORT=8000

# Keep "*" for local Flutter development.
# Restrict this to known frontend origins before production deployment.
FOODSENSE_ALLOWED_ORIGINS=*

# Firebase Admin SDK
#
# Recommended local setup:
# Generate a Firebase service-account JSON and place it at:
# backend/secrets/service-account.json
#
# Use forward slashes in the Windows path.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/himan/foodsense/backend/secrets/service-account.json

# Optional: set this explicitly if you want to pin the Firebase project.
# FOODSENSE_FIREBASE_PROJECT_ID=your-firebase-project-id

# Forecasting defaults
FOODSENSE_FORECAST_HORIZON_DAYS=1
FOODSENSE_MIN_TRAINING_RECORDS=30
FOODSENSE_SAFETY_BUFFER_PERCENT=5.0

# Local model storage
FOODSENSE_MODEL_DIRECTORY=models

# Logging
FOODSENSE_LOG_LEVEL=INFO
